__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/
.pytest_cache/
artifacts/
!artifacts/.gitkeep
var/
.DS_Store

# Cassettes are recorded from live runs; commit them deliberately, not by accident.
tests/cassettes/*.json

# The drive is generated by sandbox/seed.py and mutated by runs (files get moved
# into processed/ and exceptions/), so tracking it would show every demo as a
# pile of deletions. `python -m sandbox.serve --reset` regenerates it.
sandbox/drive/invoices-inbox/*
sandbox/drive/invoices-processed/*
sandbox/drive/invoices-exceptions/*
!sandbox/drive/**/.gitkeep
sandbox/drive/hr-inbox/*
sandbox/drive/hr-completed/*
sandbox/drive/hr-processed/*

.vercel
