# ---------------------------------------------------------------------------
# Pick ONE provider. Gemini's free tier needs no credit card:
#   https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
OPERATOR_LLM_PROVIDER=gemini

# A COMMA-SEPARATED FALLBACK CHAIN, tried in order. This is not redundancy for
# its own sake: Gemini's free tier meters 20 requests per day PER MODEL, so a
# wide chain multiplies your daily capacity (9 models here, ~180 calls/day,
# roughly 12-18 full runs). A model that returns 429 for the day is abandoned
# instantly rather than waited on, and the chain sticks to whichever model is
# answering. Order is most-capable first.
OPERATOR_LLM_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemma-4-31b-it
GEMINI_API_KEY=

# --- Alternatives (set OPERATOR_LLM_PROVIDER to match) ---------------------
# OPERATOR_LLM_PROVIDER=anthropic   OPERATOR_LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
#
# Groq free tier - https://console.groq.com/keys
# OPERATOR_LLM_PROVIDER=groq        OPERATOR_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=
#
# OpenRouter free models - https://openrouter.ai/keys
# OPERATOR_LLM_PROVIDER=openrouter  OPERATOR_LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
# OPENROUTER_API_KEY=
#
# Fully local, no key, no network - requires `ollama serve`
# OPERATOR_LLM_PROVIDER=ollama      OPERATOR_LLM_MODEL=qwen2.5:14b
#
# Deterministic replay of recorded cassettes - no key, used by the test suite
# OPERATOR_LLM_PROVIDER=replay

# --- Runtime knobs ---------------------------------------------------------
OPERATOR_LLM_CACHE=1          # cache + record every LLM call (also builds cassettes)
OPERATOR_MAX_STEPS=40         # hard ceiling on execution steps per run
OPERATOR_MAX_LLM_CALLS=80     # hard ceiling on model calls per run
OPERATOR_WALL_CLOCK_SECONDS=900
OPERATOR_HEADLESS=1           # set 0 to watch the browser drive itself
OPERATOR_SANDBOX_ERP=http://127.0.0.1:8781
OPERATOR_SANDBOX_API=http://127.0.0.1:8782
